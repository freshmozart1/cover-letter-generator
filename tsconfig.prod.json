{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "sourceMap": false,
        "declaration": false,
        // The base config sets rootDir to "." (it also typechecks test/**), which
        // would emit dist/src/*.js here. This program emits (no noEmit), and
        // package.json's main/types point at the flat dist/*.js layout, so narrow
        // rootDir back to "src" and include (below) to src/**/*.ts only.
        "rootDir": "src"
    },
    "include": ["src/**/*.ts"]
}
