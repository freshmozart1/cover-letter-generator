{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        // The base config sets rootDir to "src" so the build emits dist/*.js flat.
        // This program also includes test/**, which sits outside that root, so widen
        // it — safe because noEmit means rootDir has no effect on emitted output.
        "rootDir": "."
    },
    "include": ["test/**/*.ts", "src/**/*.ts"]
}
