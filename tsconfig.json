{
    "compilerOptions": {
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true,
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2023",
        "lib": ["es2023"],
        "types": ["node"],
        "declaration": true,
        "outDir": "dist",
        "rootDir": ".",
        "sourceMap": true
    },
    "include": ["test/**/*.ts", "src/**/*.ts"]
}
